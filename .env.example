# Replace every 192.0.2.x documentation placeholder before deploying.
AGH_URL=http://192.0.2.10:3000
AGH_USERNAME=admin
AGH_PASSWORD=change-me
UNBLOCK_ALLOWED_NETWORKS=192.0.2.20/32,127.0.0.0/8,::1/128

# Additional Portainer stack settings (not needed by docker-compose.yml).
AGH_CONTAINER=adguardhome
AGH_DNS_SERVER=192.0.2.10
FALLBACK_DNS_SERVER=1.1.1.1
AGH_QUERYLOG_FILE=/opt/adguardhome/work/data/querylog.json
AGH_CONFIG_FILE=/opt/adguardhome/conf/AdGuardHome.yaml
